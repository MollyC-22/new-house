<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>🏡 新家裝潢小幫手</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#FFFDF7',    // 米白背景
                        sakura: '#FFB7B2',   // 櫻花粉
                        mint: '#E2F0CB',     // 薄荷綠
                        babyblue: '#B5EAD7', // 寶寶藍
                        textMain: '#5C4D4D', // 深灰棕色文字
                    },
                    fontFamily: {
                        sans: ['"Zen Maru Gothic"', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        body { background-color: #FFFDF7; color: #5C4D4D; }
        /* 隱藏捲軸但保持可滾動，更像 App */
        ::-webkit-scrollbar { display: none; }
        .app-container { padding-bottom: 80px; /* 留空間給底部導覽列 */ }
        /* 點擊時的可愛回饋感 */
        .btn-press:active { transform: scale(0.95); transition: all 0.1s; }
    </style>
</head>
<body class="antialiased selection:bg-sakura selection:text-white">

    <div class="max-w-md mx-auto min-h-screen relative app-container shadow-sm bg-paper">
        
        <header class="p-5 text-center sticky top-0 bg-paper/90 backdrop-blur-sm z-10">
            <h1 class="text-xl font-bold text-textMain"><i class="fa-solid fa-house-chimney text-sakura mr-2"></i>我們的裝潢日記</h1>
        </header>

        <main class="px-5 space-y-6">
            
            <section class="bg-white p-5 rounded-3xl shadow-[0_4px_15px_rgba(255,183,178,0.2)] border-2 border-sakura/20">
                <p class="text-sm text-center mb-1">目前總花費</p>
                <h2 class="text-4xl font-bold text-center text-sakura mb-4">$<span id="total-amount">0</span></h2>
                
                <div class="flex justify-between items-center text-sm bg-paper p-3 rounded-2xl">
                    <div class="text-center w-1/2 border-r border-sakura/30">
                        <p class="mb-1">🙋‍♀️ 芝芝已付</p>
                        <p class="font-bold text-textMain" id="chichi-paid">$0</p>
                    </div>
                    <div class="text-center w-1/2">
                        <p class="mb-1">🙋‍♂️ 小T已付</p>
                        <p class="font-bold text-textMain" id="littlet-paid">$0</p>
                    </div>
                </div>
            </section>

            <section class="bg-white p-5 rounded-3xl shadow-sm border-2 border-mint/30">
                <h3 class="font-bold mb-4"><i class="fa-solid fa-pen text-mint mr-2"></i>記一筆</h3>
                
                <form id="expense-form" class="space-y-4">
                    <div>
                        <input type="number" id="amount" placeholder="輸入金額..." required
                               class="w-full text-2xl p-3 bg-paper rounded-2xl focus:outline-none focus:ring-2 focus:ring-sakura text-center font-bold">
                    </div>
                    
                    <div>
                        <input type="text" id="item-name" placeholder="例如：TOTO 馬桶、設計費..." required
                               class="w-full p-3 bg-paper rounded-2xl focus:outline-none focus:ring-2 focus:ring-sakura">
                    </div>

                    <div class="flex gap-2">
                        <label class="flex-1 text-center cursor-pointer">
                            <input type="radio" name="payer" value="芝芝" class="peer hidden" checked>
                            <div class="p-3 rounded-2xl bg-paper peer-checked:bg-sakura peer-checked:text-white transition font-bold btn-press">
                                🙋‍♀️ 芝芝
                            </div>
                        </label>
                        <label class="flex-1 text-center cursor-pointer">
                            <input type="radio" name="payer" value="小T" class="peer hidden">
                            <div class="p-3 rounded-2xl bg-paper peer-checked:bg-babyblue peer-checked:text-textMain transition font-bold btn-press">
                                🙋‍♂️ 小T
                            </div>
                        </label>
                    </div>

                    <button type="button" class="w-full p-3 border-2 border-dashed border-sakura text-sakura rounded-2xl font-bold flex justify-center items-center gap-2 btn-press" onclick="alert('報價單 AI 識別功能需要串接後端 API，稍後可以擴充！')">
                        <i class="fa-solid fa-camera"></i> 拍報價單自動匯入
                    </button>

                    <button type="submit" class="w-full p-4 bg-sakura text-white rounded-2xl font-bold text-lg shadow-md btn-press">
                        儲存花費
                    </button>
                </form>
            </section>

            <section class="pb-10">
                <h3 class="font-bold mb-4 pl-2">近期明細</h3>
                <div id="expense-list" class="space-y-3">
                    </div>
            </section>

        </main>

        <nav class="fixed bottom-0 w-full max-w-md bg-white border-t border-gray-100 pb-safe pt-2 px-6 flex justify-between items-center text-xs shadow-[0_-10px_20px_rgba(0,0,0,0.03)] rounded-t-3xl z-20">
            <button class="flex flex-col items-center p-2 text-sakura"><i class="fa-solid fa-house text-lg mb-1"></i>首頁</button>
            <button class="flex flex-col items-center p-2 text-gray-400"><i class="fa-solid fa-list-check text-lg mb-1"></i>清單</button>
            <button class="flex flex-col items-center p-2 text-gray-400"><i class="fa-solid fa-chart-pie text-lg mb-1"></i>統計</button>
            <button class="flex flex-col items-center p-2 text-gray-400"><i class="fa-solid fa-gear text-lg mb-1"></i>設定</button>
        </nav>

    </div>

    <script>
        // 暫存資料的陣列 (後續可替換為 Firebase)
        let expenses = [];

        // DOM 元素
        const form = document.getElementById('expense-form');
        const listContainer = document.getElementById('expense-list');
        const totalEl = document.getElementById('total-amount');
        const chichiPaidEl = document.getElementById('chichi-paid');
        const littletPaidEl = document.getElementById('littlet-paid');

        // 格式化金錢
        const formatMoney = (num) => new Intl.NumberFormat('zh-TW').format(num);

        // 更新畫面與統計
        function updateUI() {
            // 清空列表
            listContainer.innerHTML = '';
            
            let total = 0;
            let chichiTotal = 0;
            let littletTotal = 0;

            // 渲染列表 (反轉陣列讓最新的在上面)
            [...expenses].reverse().forEach(exp => {
                total += exp.amount;
                if(exp.payer === '芝芝') chichiTotal += exp.amount;
                if(exp.payer === '小T') littletTotal += exp.amount;

                const item = document.createElement('div');
                item.className = 'bg-white p-4 rounded-2xl shadow-sm flex justify-between items-center border border-gray-50';
                item.innerHTML = `
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm ${exp.payer === '芝芝' ? 'bg-sakura text-white' : 'bg-babyblue text-textMain'}">
                            ${exp.payer === '芝芝' ? '芝' : 'T'}
                        </div>
                        <div>
                            <p class="font-bold">${exp.name}</p>
                            <p class="text-xs text-gray-400">${exp.date}</p>
                        </div>
                    </div>
                    <div class="font-bold text-lg text-textMain">$${formatMoney(exp.amount)}</div>
                `;
                listContainer.appendChild(item);
            });

            // 更新儀表板
            totalEl.innerText = formatMoney(total);
            chichiPaidEl.innerText = `$${formatMoney(chichiTotal)}`;
            littletPaidEl.innerText = `$${formatMoney(littletTotal)}`;
        }

        // 處理表單送出
        form.addEventListener('submit', (e) => {
            e.preventDefault();
            
            const amount = parseInt(document.getElementById('amount').value);
            const name = document.getElementById('item-name').value;
            const payer = document.querySelector('input[name="payer"]:checked').value;
            const today = new Date();
            const dateStr = `${today.getMonth()+1}/${today.getDate()}`;

            // 新增資料
            expenses.push({ amount, name, payer, date: dateStr });
            
            // 這裡未來可以加入 Firebase 上傳的程式碼:
            // db.collection("expenses").add({ amount, name, payer, date: dateStr })
            
            updateUI();
            form.reset();
            // 預設切回芝芝
            document.querySelector('input[name="payer"][value="芝芝"]').checked = true;
        });

        // 載入預設假資料看效果
        expenses.push(
            { amount: 50000, name: '訂金 - 系統櫃', payer: '小T', date: '6/8' },
            { amount: 3500, name: '油漆耗材', payer: '芝芝', date: '6/9' }
        );
        updateUI();
    </script>
</body>
</html>
